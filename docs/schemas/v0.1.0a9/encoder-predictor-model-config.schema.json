{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haiyuan-yu-lab.github.io/xp-seq2func-model-docs/schemas/v0.1.0a9/encoder-predictor-model-config.schema.json",
  "title": "EncoderPredictor model_config (v0.1.0a9 documentation snapshot)",
  "description": "Documentation-owned schema snapshot for the top-level EncoderPredictor model_config tree in exact release v0.1.0a9. Not a canonical runtime definition. Runtime also enforces unique model_name values across the tree and L_embed = L - 2T > 0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_name", "encoder", "predictor", "embedding_trimming"],
  "properties": {
    "model_name": {
      "$ref": "defs.schema.json#/$defs/modelName"
    },
    "embedding_trimming": {
      "$ref": "defs.schema.json#/$defs/nonNegativeInteger"
    },
    "encoder": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_type", "model_config"],
          "properties": {
            "model_type": { "const": "ConvEncoder" },
            "model_config": {
              "$ref": "defs.schema.json#/$defs/identityModelConfig"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_type", "model_config"],
          "properties": {
            "model_type": { "const": "ConvSelfAttEncoder" },
            "model_config": {
              "$ref": "defs.schema.json#/$defs/identityModelConfig"
            }
          }
        }
      ]
    },
    "predictor": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/predictorMapKey"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["model_type", "model_config"],
            "properties": {
              "model_type": { "const": "ClassPredictor" },
              "model_config": {
                "$ref": "defs.schema.json#/$defs/classPredictorModelConfig"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["model_type", "model_config"],
            "properties": {
              "model_type": { "const": "RCClassPredictor" },
              "model_config": {
                "$ref": "defs.schema.json#/$defs/classPredictorModelConfig"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["model_type", "model_config"],
            "properties": {
              "model_type": { "const": "RegressPredictor" },
              "model_config": {
                "$ref": "defs.schema.json#/$defs/identityModelConfig"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["model_type", "model_config"],
            "properties": {
              "model_type": { "const": "RCRegressPredictor" },
              "model_config": {
                "$ref": "defs.schema.json#/$defs/identityModelConfig"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["model_type", "model_config"],
            "properties": {
              "model_type": { "const": "ProfilePredictor" },
              "model_config": {
                "$ref": "defs.schema.json#/$defs/profilePredictorModelConfig"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["model_type", "model_config"],
            "properties": {
              "model_type": { "const": "RCProfilePredictor" },
              "model_config": {
                "$ref": "defs.schema.json#/$defs/rcProfilePredictorModelConfig"
              }
            }
          }
        ]
      }
    }
  }
}
