{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haiyuan-yu-lab.github.io/xp-seq2func-model-docs/schemas/v0.1.0a8/train-config.schema.json",
  "title": "train_model config JSON (v0.1.0a8 documentation snapshot)",
  "description": "Documentation-owned schema snapshot for the train_model --config JSON in exact release v0.1.0a8. Not a canonical runtime definition. Forbidden top-level keys include optimizer and loss. Runtime also validates CUDA, array contents, init_checkpoint module names, and composition uniqueness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_type",
    "model_config",
    "train_data",
    "val_data",
    "job_name",
    "random_seed",
    "max_epochs",
    "early_stopping",
    "wandb"
  ],
  "properties": {
    "model_type": {
      "const": "EncoderPredictor"
    },
    "model_config": {
      "$ref": "encoder-predictor-model-config.schema.json"
    },
    "train_data": {
      "$ref": "data-source.schema.json"
    },
    "val_data": {
      "$ref": "data-source.schema.json"
    },
    "job_name": {
      "$ref": "defs.schema.json#/$defs/nonEmptyString",
      "description": "Non-empty stem for artifacts and the Weights & Biases run name."
    },
    "random_seed": {
      "type": "integer"
    },
    "max_epochs": {
      "$ref": "defs.schema.json#/$defs/positiveInteger"
    },
    "early_stopping": {
      "$ref": "early-stopping.schema.json"
    },
    "wandb": {
      "$ref": "wandb-train.schema.json"
    },
    "init_checkpoint": {
      "$ref": "init-checkpoint.schema.json"
    }
  }
}
